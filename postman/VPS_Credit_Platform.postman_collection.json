{
	"info": {
		"name": "VPS Credit Platform",
		"description": "Plataforma B2B de gestao de creditos para parceiros.\n\n## Como usar\n\n1. Importe esta collection no Postman\n2. Suba os servicos: `docker compose up -d`\n3. Execute as requests na ordem das pastas\n4. A variavel `partnerId` e preenchida automaticamente ao criar um parceiro\n5. A variavel `transactionId` e preenchida automaticamente ao criar uma transacao",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:7200"
		},
		{
			"key": "apiKey",
			"value": "changeme-dev-only"
		},
		{
			"key": "partnerId",
			"value": ""
		},
		{
			"key": "transactionId",
			"value": ""
		}
	],
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "X-API-Key",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{apiKey}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Health",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Service is healthy', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('UP');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "1. Partners",
			"item": [
				{
					"name": "Criar parceiro",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"externalId\": \"PARTNER-001\",\n    \"name\": \"Empresa Teste\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/partners",
							"host": ["{{baseUrl}}"],
							"path": ["partners"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Partner created (201)', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Save partnerId', function () {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('partnerId', json.id);",
									"    pm.expect(json.externalId).to.eql('PARTNER-001');",
									"    pm.expect(json.balance).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Consultar parceiro",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/partners/{{partnerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "{{partnerId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Partner found (200)', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.id).to.eql(pm.collectionVariables.get('partnerId'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Consultar saldo",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/partners/{{partnerId}}/balance",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "{{partnerId}}", "balance"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Balance returned (200)', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.balance).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Parceiro duplicado (409)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
