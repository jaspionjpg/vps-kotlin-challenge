							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"externalId\": \"PARTNER-001\",\n    \"name\": \"Duplicado\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/partners",
