						"url": {
							"raw": "{{baseUrl}}/partners/00000000-0000-0000-0000-000000000000",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "00000000-0000-0000-0000-000000000000"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Partner not found (404)', function () {",
