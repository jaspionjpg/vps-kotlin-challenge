								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "2. Transactions - Credit",
			"item": [
				{
					"name": "Adicionar credito R$1000",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "credit-001"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 1000.00,\n    \"description\": \"Carga inicial de creditos\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/partners/{{partnerId}}/transactions/credit",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "{{partnerId}}", "transactions", "credit"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Credit created (201)', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Transaction is COMPLETED', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.type).to.eql('CREDIT');",
									"    pm.expect(json.status).to.eql('COMPLETED');",
									"    pm.expect(json.amount).to.eql(1000.0);",
									"    pm.collectionVariables.set('transactionId', json.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Verificar saldo = 1000",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/partners/{{partnerId}}/balance",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "{{partnerId}}", "balance"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Balance is 1000', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.balance).to.eql(1000.0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Idempotencia — mesma key (409)",
