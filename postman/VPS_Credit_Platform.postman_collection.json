						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "credit-001"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 1000.00,\n    \"description\": \"Tentativa duplicada\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/partners/{{partnerId}}/transactions/credit",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "{{partnerId}}", "transactions", "credit"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Duplicate rejected (409)', function () {",
									"    pm.response.to.have.status(409);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Verificar saldo nao mudou = 1000",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/partners/{{partnerId}}/balance",
							"host": ["{{baseUrl}}"],
							"path": ["partners", "{{partnerId}}", "balance"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Balance unchanged after idempotency reject', function () {",
